## Generated by Schematic Studio for the EDGE Spartan-7 (xc7s15ftgb196-1)
## Top entity: top

## clk -> clk (Clock)
set_property -dict { PACKAGE_PIN H11 IOSTANDARD LVCMOS33 } [get_ports { clk }];
## cnt0 -> led[0] (LEDs)
set_property -dict { PACKAGE_PIN K12 IOSTANDARD LVCMOS33 } [get_ports { cnt0 }];
## cnt1 -> led[1] (LEDs)
set_property -dict { PACKAGE_PIN M12 IOSTANDARD LVCMOS33 } [get_ports { cnt1 }];

## 50 MHz board clock
create_clock -period 20.000 -name sys_clk [get_ports { clk }];

## Configuration: 3.3 V bank, boot from the s25fl064l SPI flash in x4 mode
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
